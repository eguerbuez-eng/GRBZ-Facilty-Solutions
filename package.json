{
  "name": "grbz-facility-management-system",
  "version": "1.0.0",
  "description": "GRBZ Facility Management System – PWA für Gebäudereinigung und Facility Management",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 tests/*.test.js",
    "test:e2e": "NODE_PATH=\"$(npm root -g)\" node --disable-warning=ExperimentalWarning tests-e2e/e2e.mjs",
    "backup": "node --disable-warning=ExperimentalWarning server/backup.js",
    "create-admin": "node --disable-warning=ExperimentalWarning server/create-admin.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "jsqr": "^1.4.0",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  }
}
